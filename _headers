# Netlify headers. The site is one HTML file plus a folder of photos, so the
# only thing worth caching hard is the media.

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Photos and the video never change under the same name, so cache them hard.
/img/*
  Cache-Control: public, max-age=31536000, immutable

# The page itself must always be fresh - it is where the prices live.
/index.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff

/404.html
  Cache-Control: public, max-age=0, must-revalidate
